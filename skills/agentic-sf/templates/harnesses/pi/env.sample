# agentic-sf environment, for a factory stamped with `--harness pi`.
#
# Every pi `model:` is provider/model-id; the provider half decides which key
# must be set. The stamped default names google/... via openrouter.

OPENROUTER_API_KEY=

# Where the agentic-sf skill itself lives. install.py fills this in from the
# path it ran from and leaves whatever is already here alone.
ASF_SKILL=

# Optional overrides
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name

# ── the cockpit: LOCAL or TEAM ───────────────────────────────────────────────
#
# install.py asks which (`--cockpit local|team`); this file is where the answer
# lives, and you may change it here at any time (the skill's
# cookbooks/switch_cockpit.md says what else changes with it).
#
# LOCAL — the default: ASF_COCKPIT_URL unset. `asf up` starts a cockpit on this
# machine — the same images a team deploys, on Docker, at http://localhost:3000
# — issues itself a token and ships every session to it. Only you see it.
#
# TEAM — a shared cockpit: everyone's sessions in one place, and claims, so two
# stations never start the same work item. One value, from whoever runs it:
#   ASF_COCKPIT_URL  the backend's SITE origin, where stations ship:
#                    https://<name>.convex.site on Convex Cloud (not the
#                    .convex.cloud address), CONVEX_SITE_ORIGIN (:3211) on a
#                    team's `docker compose up` — never the cockpit's pages
#                    (:3000) or its API (:3210).
# Then `just station-register` is all: a person with write on the repository
# approves its code in the cockpit, and the station keeps the ingest token that
# hands it (the skill's cookbooks/connect_cockpit.md).
# ASF_COCKPIT_TOKEN is for where no device flow runs — CI, issued by a
# repository admin on the factory page's Stations tab — and wins when set.
# ASF_COCKPIT_URL=https://<name>.convex.site
# ASF_COCKPIT_TOKEN=asf_ingest_…
# ASF_STATION_NAME=                # how the cockpit names this checkout; default <login>@<host>:<dir>

# The LOCAL cockpit's knobs (ignored with ASF_COCKPIT_URL set). The version is
# never older than asf/cockpit/min-version; name a newer release to run that
# one. It asks the forge as you: `asf up` hands it what `gh auth token` prints,
# for GH_HOST when that is set (an Enterprise Server) and github.com otherwise.
# Nothing to set here — the token is never written to this file.
# ASF_COCKPIT_VERSION=
# ASF_COCKPIT_APP_PORT=3000
# ASF_COCKPIT_BACKEND_PORT=3210
# ASF_COCKPIT_SITE_PORT=3211
# How many days the local cockpit keeps a finished session's transcript before
# aging it out (factory.yaml's cockpit.transcript_retention_days can only
# shorten it). Raise it here if you want them longer.
# ASF_COCKPIT_TRANSCRIPT_DAYS=30
