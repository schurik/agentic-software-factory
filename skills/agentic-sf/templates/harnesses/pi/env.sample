# agentic-sf environment, for a factory stamped with `--harness pi`.
#
# Every pi `model:` is provider/model-id; the provider half decides which key
# must be set. The stamped default names google/... via openrouter.

OPENROUTER_API_KEY=

# Where the agentic-sf skill itself lives. install.py fills this in from the
# path it ran from and leaves whatever is already here alone.
ASF_SKILL=

# Optional overrides
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name

# A SHARED cockpit to ship this checkout's sessions to (optional). The URL is
# the backend's SITE origin: https://<name>.convex.site on Convex Cloud, :3211
# on a team's `docker compose up`. With only the URL set, `just
# station-register` connects this checkout — a person with write approves it in
# the browser, and the station is handed the factory's ingest token, kept in
# asf/data/station-token.json (the agentic-sf skill's cookbooks/
# connect_cockpit.md). ASF_COCKPIT_TOKEN, an ingest token issued some other way
# (a CI job's, from the factory page), wins when set. Unset, a run ships
# nothing and waits on nothing, and `asf up` starts a LOCAL cockpit instead —
# the same images, on Docker, at http://localhost:3000 — and ships to that.
# ASF_COCKPIT_URL=http://127.0.0.1:3211
# ASF_COCKPIT_TOKEN=asf_ingest_…
# ASF_STATION_NAME=                # how the cockpit names this checkout; default <login>@<host>:<dir>

# The local cockpit (only without ASF_COCKPIT_URL). The version is never older
# than asf/cockpit/min-version; name a newer release to run that one. It asks
# the forge as you: `asf up` hands it what `gh auth token` prints, for GH_HOST
# when that is set (an Enterprise Server) and github.com otherwise. Nothing to
# set here — the token is never written to this file.
# ASF_COCKPIT_VERSION=
# ASF_COCKPIT_APP_PORT=3000
# ASF_COCKPIT_BACKEND_PORT=3210
# ASF_COCKPIT_SITE_PORT=3211
# How many days the local cockpit keeps a finished session's transcript before
# aging it out (factory.yaml's cockpit.transcript_retention_days can only
# shorten it). Raise it here if you want them longer.
# ASF_COCKPIT_TRANSCRIPT_DAYS=30
