# agentic-sf environment, for a factory stamped with `--harness pi`.
#
# Every pi `model:` is provider/model-id; the provider half decides which key
# must be set. The stamped default names google/... via openrouter.

OPENROUTER_API_KEY=

# Where the agentic-sf skill itself lives. install.py fills this in from the
# path it ran from and leaves whatever is already here alone.
ASF_SKILL=

# Optional overrides
# PI_PATH=pi                       # pi binary if not on PATH
# PI_MODELS_PATH=~/.pi/agent/models.json
# ENGINEER_NAME=                   # engineer lane label, defaults to git user.name

# A cockpit to ship this checkout's sessions to (optional). Unset, nothing is
# shipped and nothing waits. The URL is the backend's SITE origin (:3211 on a
# local `docker compose up`), the token a factory-scoped ingest token that
# cockpit issued for this repository (`tokens:issue`, in the cockpit's README).
# ASF_COCKPIT_URL=http://127.0.0.1:3211
# ASF_COCKPIT_TOKEN=asf_ingest_…
# ASF_STATION_NAME=                # how the cockpit names this checkout; default <login>@<host>:<dir>
