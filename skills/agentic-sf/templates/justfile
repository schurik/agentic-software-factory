# agentic-sf recipes. Stamped by install.py, then yours to edit.
#
# Every recipe is one line over `asf/asf.py`; `just --list` is the menu. A
# repository that already had a justfile of its own got this file as
# `asf.justfile` instead — run it with `just -f asf.justfile <recipe>`, or
# add `import 'asf.justfile'` to the other one (rename on import if recipe
# names collide).

# `.env` reaches every run through this, so keys work without exporting them.
set dotenv-load
set positional-arguments

# `ASF_CONFIG=other.yaml just do "..."` swaps the whole factory for one run.
config := env_var_or_default("ASF_CONFIG", "asf/factory.yaml")
asf    := "uv run asf/asf.py --config " + config

# list every recipe
default:
    @just --list

# ── first run ───────────────────────────────────────────────────────────────

# is this repo ready to run anything? checks + fixes, no agents, no cost
doctor:
    @{{asf}} doctor

# the forge labels this config names: just labels [--create]
labels *ARGS:
    @{{asf}} labels "$@"

# every workflow, one line each
list:
    @{{asf}} list

# load and validate every workflow — spawns nothing: just check [name]
check *ARGS:
    @{{asf}} check "$@"

# ── run a workflow ──────────────────────────────────────────────────────────
# Args pass straight through: "<prompt or path/to/prompt.md>" [--adw-id X] [--hitl plan]

# the default: plan, implement, verify, commit — just do "add a /health endpoint"
do *ARGS:
    {{asf}} run sdlc "$@"

# no plan: implement, verify, commit — just quick "rename the flag"
quick *ARGS:
    {{asf}} run quick "$@"

# the full chain, three commits, landed — just ship "add a /health endpoint"
ship *ARGS:
    {{asf}} run ship "$@"

# any workflow by name: just run <workflow> "<prompt>"
run WORKFLOW *ARGS:
    {{asf}} run {{WORKFLOW}} "${@:2}"

# a tracked work item, end to end, proposed as a pull request: just issue 42
issue NUMBER *ARGS:
    {{asf}} run issue {{NUMBER}} "${@:2}"

# settle what a work item is asking for, with a person, and write it back: just refine 42
refine NUMBER *ARGS:
    {{asf}} run refine {{NUMBER}} "${@:2}"

# settle it with a person AND build it, in one run: just refine-ship 42
refine-ship NUMBER *ARGS:
    {{asf}} run refine-ship {{NUMBER}} "${@:2}"

# answer the review threads on one of this factory's pull requests: just pr-review 17
pr-review NUMBER *ARGS:
    {{asf}} run pr-review {{NUMBER}} "${@:2}"

# ── pick a run back up ──────────────────────────────────────────────────────

# re-run a failed run from where it stopped: just resume <adw_id>
resume ADW_ID *ARGS:
    {{asf}} resume {{ADW_ID}} "${@:2}"

# stop a run — its agents first, then the workflow: just kill <adw_id> [--force]
kill ADW_ID *ARGS:
    {{asf}} kill {{ADW_ID}} "${@:2}"

# ── answer a gate ───────────────────────────────────────────────────────────
# A stage with `hitl: true` (or `--hitl` on the run) stops the run with exit
# 75 and the session reading `waiting`; nothing spends while it waits.

# runs stopped at a gate, waiting for you
pending:
    @{{asf}} pending

# what a waiting run wants you to read: just show <adw_id>
show ADW_ID:
    @{{asf}} show {{ADW_ID}}

# approve the artifact and continue the run: just approve <adw_id> [-m "remarks"]
approve ADW_ID *ARGS:
    {{asf}} approve {{ADW_ID}} "${@:2}"

# answer what a question round asked: just answer <adw_id> -m "the refresh path"
# (`approve` there means "every recommendation as it stands" — one word, seven answers)
answer ADW_ID *ARGS:
    {{asf}} answer {{ADW_ID}} "${@:2}"

# send it back with notes; the agent revises, then asks again: just reject <adw_id> -m "..."
reject ADW_ID *ARGS:
    {{asf}} reject {{ADW_ID}} "${@:2}"

# end the run at the gate, not accepted: just abort <adw_id> [-m "why"]
abort ADW_ID *ARGS:
    {{asf}} abort {{ADW_ID}} "${@:2}"

# ── the long-running parts ──────────────────────────────────────────────────
# The station loop, the local cockpit and the watchers. Forgetting one is
# silent — a watcher that is not running looks exactly like one with nothing
# to do — so `just up` starts all of them in one process and `just status`
# says what is actually running.

# start everything: station loop, local cockpit (needs Docker), the watchers; ctrl-c stops it all
up *ARGS:
    {{asf}} up "$@"

# the station loop alone: ship every session to the cockpit, start no watcher
station:
    {{asf}} station

# is anything actually running? watchers, their last poll, runs in flight
status:
    @{{asf}} status

# one poll of the tracker: launch a run per queued, routed issue
issues:
    {{asf}} issues once

# one poll for answers: resume every run somebody answered on its work item
answers:
    {{asf}} answers once

# which runs are waiting on an answer from the tracker, and who may give it
answers-status:
    @{{asf}} answers status

# cron form: poll for answers forever
answers-watch *ARGS:
    {{asf}} answers loop "${@:2}"

# what the issue watcher would do, and whether it can
issues-status:
    @{{asf}} issues status

# keep polling — the cron form; `just up` is the one for a terminal
issues-watch *ARGS:
    {{asf}} issues loop "$@"

# one poll of the open pull requests: answer what has review threads
prs:
    {{asf}} prs once

# what the review watcher would do, and whether it can
prs-status:
    @{{asf}} prs status

# keep polling; --pr <n> follows one pull request and exits when it lands
prs-watch *ARGS:
    {{asf}} prs loop "$@"

# ── worktrees ───────────────────────────────────────────────────────────────
# One per run, kept on failure. Branches are never deleted by any of these.

# every run worktree, with the state of the run that owns it
worktrees:
    @{{asf}} worktrees list

# remove the worktrees of ENDED runs with CLEAN trees; --force takes dirty ones too
worktrees-prune *ARGS:
    {{asf}} worktrees prune "$@"

# remove one run's worktree: just worktrees-remove <adw_id> [--force]
worktrees-remove ADW_ID *ARGS:
    {{asf}} worktrees remove {{ADW_ID}} "${@:2}"

# ── the cockpit ─────────────────────────────────────────────────────────────
# `just up` ships every session; runs ship their own when ASF_COCKPIT_URL is
# set; this is the catch-up. A shared cockpit sends a station commands once a
# person approved it there.

# ship every session the cockpit has not acknowledged — a CI job's last step
station-sync:
    {{asf}} station sync

# let a shared cockpit send this station commands: prints a code to approve there
station-register:
    {{asf}} station register

# ── watch it ────────────────────────────────────────────────────────────────
# Read from each session's own directory; the cockpit `just up` starts shows
# the same sessions whole.

# the newest runs: just sessions [--limit 20]
sessions *ARGS:
    @{{asf}} sessions "$@"

# the end of a run's events: just tail <adw_id> — its events.jsonl, newest last (default data_dir)
tail ADW_ID:
    @tail -n 25 asf/data/sessions/{{ADW_ID}}/events.jsonl

# ── leaving ─────────────────────────────────────────────────────────────────

# delete the stamped factory out of this repo; the skill is untouched: just uninstall [--dry-run]
uninstall *ARGS:
    uv run "${ASF_SKILL:?not set - re-run install.py, which writes it into .env}/scripts/uninstall.py" --config {{config}} "$@"
